{"nodes": [{"id": "samples_forge_prompt_ai_chat_rich", "label": "Forge Prompt \u2014 Rich AI Chat (Forge Chat)", "file_type": "document", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "samples_forge_prompt_ai_chat_rich_forge_chat", "label": "Forge Chat mini-app", "file_type": "concept", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attachments are passed only on the first ai.chat hop and never persisted, because multi-MB base64 in messages or storage bloats context; compact history (finals only, tool protocol rows dropped after the turn) is the default to reduce provider bugs."}, {"id": "samples_forge_prompt_ai_chat_rich_app_tools", "label": "APP_TOOLS (OpenAI tool definitions)", "file_type": "code", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OpenAI-shaped tools[] is passed on every hop so the model can chain calls; the host adapts the shape per provider (e.g. Gemini functionDeclarations)."}, {"id": "samples_forge_prompt_ai_chat_rich_executetool", "label": "executeTool", "file_type": "code", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "list_apps/list_activities return compact summaries (packageName + label only) to avoid huge payloads to the model; launch_app honours the confirm-before-launch setting."}, {"id": "samples_forge_prompt_ai_chat_rich_runchatturn", "label": "runChatTurn", "file_type": "code", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The host only normalizes provider wire formats into a unified tool_calls[]; it does not execute tools, so the mini-app must run the call\u2192execute\u2192feed\u2192re-call loop itself, with maxTool Rounds capping infinite loops."}, {"id": "samples_forge_prompt_ai_chat_rich_stringifytoolresult", "label": "stringifyToolResult", "file_type": "code", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tool results are truncated to ~12000 chars to keep context small for weak models."}, {"id": "samples_forge_prompt_ai_chat_rich_normalizechatresult", "label": "normalizeChatResult", "file_type": "code", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Providers return wildly diverse tool-call shapes (OpenAI tool_calls, legacy function_call, camelCase proxies, Anthropic-style parts, choices[0].message passthrough, text-dumped tools), so results must be normalized defensively before the loop can act on them."}, {"id": "samples_forge_prompt_ai_chat_rich_scrapetoolsfromtext", "label": "scrapeToolsFromText", "file_type": "code", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safety net for non-tool models that dump tool calls as fenced ```tool blocks or <tool_call> XML; only names present in APP_TOOLS are accepted to prevent arbitrary calls."}, {"id": "samples_forge_prompt_ai_chat_rich_splitassistantcontent", "label": "splitAssistantContent", "file_type": "code", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A heuristic fallback (content starting with '<' and ending with a closing tag) catches HTML replies that omit the <!--forge-html--> wrapper before rendering in a sandboxed iframe."}, {"id": "samples_forge_prompt_ai_chat_rich_tochatattachment", "label": "toChatAttachment", "file_type": "code", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosts return heterogeneous shapes (dataUrl/base64/bytes), so attachments are normalized into the unified image/file contract before being passed to ai.chat."}, {"id": "samples_forge_prompt_ai_chat_rich_forgehost_ai_chat", "label": "ForgeHost.ai.chat", "file_type": "concept", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "samples_forge_prompt_ai_chat_rich_forgehost_ai_listproviders", "label": "ForgeHost.ai.listProviders", "file_type": "concept", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "samples_forge_prompt_ai_chat_rich_forgehost_apps_list", "label": "ForgeHost.apps.list", "file_type": "concept", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "samples_forge_prompt_ai_chat_rich_forgehost_apps_listactivities", "label": "ForgeHost.apps.listActivities", "file_type": "concept", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "samples_forge_prompt_ai_chat_rich_forgehost_apps_launch", "label": "ForgeHost.apps.launch", "file_type": "concept", "source_file": "samples/Forge_Prompt_AI_Chat_Rich.md", "source_location": null, "source_url": nu