#!/data/data/com.termux/files/usr/bin/bash
# Forge Termux agent — HTTP + file-queue bridge (Play Termux OK)
set -euo pipefail
PORT="${FORGE_AGENT_PORT:-8787}"
ROOT="${FORGE_BRIDGE_DIR:-/storage/emulated/0/Download/ForgeBridge}"
VERSION="1.1.0"
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"
mkdir -p "$ROOT/inbox" "$ROOT/outbox"

# Precondition: python must be present — auto-install via pkg when missing.
# Runs BEFORE --daemon so the install happens in the foreground (the daemon
# child discards output and would fail silently otherwise).
if ! command -v python3 >/dev/null && ! command -v python >/dev/null; then
  if ! command -v pkg >/dev/null; then
    echo "python required but pkg not found — install it with: pkg install python" >&2
    exit 1
  fi
  echo "python not found — installing (this can take a minute)…" >&2
  pkg install -y python || {
    pkg update -y >/dev/null 2>&1 || true
    pkg install -y python
  } || {
    echo "failed to install python — run manually: pkg install python" >&2
    exit 1
  }
fi
PY="$(command -v python3 || command -v python)"

if [[ "${1:-}" == "--daemon" ]]; then
  shift
  nohup "$0" "$@" >/dev/null 2>&1 &
  echo "forge-termux-agent daemon pid $! port $PORT"
  exit 0
fi


export FORGE_AGENT_PORT="$PORT" FORGE_BRIDGE_ROOT="$ROOT" FORGE_AGENT_VERSION="$VERSION"
export PREFIX HOME
exec "$PY" - "$@" <<'PY'
import json, os, socketserver, subprocess, threading, time, traceback
from http.server import BaseHTTPRequestHandler
from pathlib import Path

PORT = int(os.environ.get("FORGE_AGENT_PORT", "8787"))
ROOT = Path(os.environ.get("FORGE_BRIDGE_ROOT", "/storage/emulated/0/Download/ForgeBridge"))
INBOX, OUTBOX = ROOT / "inbox", ROOT / "outbox"
INBOX.mkdir(parents=True, exist_ok=True)
OUTBOX.mkdir(parents=True, exist_ok=True)
VERSION = os.environ.get("FORGE_AGENT_VERSION", "1.0.0")
HOME = os.environ.get("HOME", "/data/data/com.termux/files/home")
PREFIX = os.environ.get("PREFIX", "/data/data/com.termux/files/usr")
PID = os.getpid()

def status():
    return {
        "ok": True,
        "pid": PID,
        "version": VERSION,
        "home": HOME,
        "prefix": PREFIX,
        "port": PORT,
        "root": str(ROOT),
        "ts": int(time.time()),
    }

def write_heartbeat():
    try:
        (ROOT / "agent.json").write_text(json.dumps(status()), encoding="utf-8")
    except Exception:
        pass

def run_job(job):
    t0 = time.time()
    cwd = job.get("cwd") or HOME
    timeout = max(1, min(int(job.get("timeoutMs") or 120000) / 1000.0, 600))
    env = os.environ.copy()
    env["HOME"] = HOME
    env["PREFIX"] = PREFIX
    env["PATH"] = f"{PREFIX}/bin:" + env.get("PATH", "")
    try:
        if job.get("script"):
            cmd = [f"{PREFIX}/bin/bash", "-lc", job["script"]]
        else:
            cmd_path = job.get("cmdPath") or f"{PREFIX}/bin/bash"
            args = job.get("args") or []
            if not isinstance(args, list):
                args = []
            cmd = [cmd_path] + [str(a) for a in args]
        # wait=False => fire-and-forget (Forge termux.run)
        if job.get("wait") is False:
            subprocess.Popen(cmd, cwd=cwd, env=env, start_new_session=True)
            return {
                "ok": True,
                "stdout": "",
                "stderr": "",
                "exitCode": 0,
                "note": "started background",
                "id": job.get("id"),
            }
        p = subprocess.run(
            cmd,
            cwd=cwd,
            env=env,
            capture_output=True,
            text=True,
            timeout=timeout,
            errors="replace",
        )
        return {
            "ok": p.returncode == 0,
            "stdout": p.stdout or "",
            "stderr": p.stderr or "",
            "exitCode": p.returncode,
            "id": job.get("id"),
            "ms": int((time.time() - t0) * 1000),
        }
    except subprocess.TimeoutExpired as e:
        out = (e.stdout or "") if isinstance(e.stdout, str) else ""
        err = (e.stderr or "") if isinstance(e.stderr, str) else ""
        return {
            "ok": False,
            "stdout": out,
            "stderr": err or "timeout",
            "exitCode": 124,
            "errmsg": f"timeout after {timeout}s",
            "id": job.get("id"),
        }
    except Exception as e:
        return {
            "ok": False,
            "stdout": "",
            "stderr": traceback.format_exc(),
            "exitCode": 1,
            "errmsg": str(e),
            "id": job.get("id"),
        }

class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, obj):
        b = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        if self.path.startswith("/status") or self.path == "/":
            self._send(200, status())
        else:
            self._send(404, {"ok": False, "errmsg": "not found"})

    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(n).decode("utf-8", "replace") if n else "{}"
        try:
            job = json.loads(raw or "{}")
        except Exception as e:
            self._send(400, {"ok": False, "errmsg": f"bad json: {e}"})
            return
        if self.path.startswith("/exec") or self.path.startswith("/run"):
            self._send(200, run_job(job))
        else:
            self._send(404, {"ok": False, "errmsg": "not found"})

def file_worker():
    while True:
        try:
            write_heartbeat()
            for f in sorted(INBOX.glob("*.json")):
                try:
                    job = json.loads(f.read_text(encoding="utf-8"))
                except Exception:
                    try:
                        f.unlink()
                    except Exception:
                        pass
                    continue
                res = run_job(job)
                out = OUTBOX / f.name
                out.write_text(json.dumps(res), encoding="utf-8")
                try:
                    f.unlink()
                except Exception:
                    pass
        except Exception:
            pass
        time.sleep(0.25)

threading.Thread(target=file_worker, daemon=True).start()
write_heartbeat()

class ReusableTCPServer(socketserver.TCPServer):
    allow_reuse_address = True

print(f"forge-termux-agent v{VERSION} on 127.0.0.1:{PORT} root={ROOT}", flush=True)
with ReusableTCPServer(("127.0.0.1", PORT), H) as httpd:
    httpd.serve_forever()
PY
