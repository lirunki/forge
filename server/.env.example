# Template only: create a private copy on the VM; never commit real values.
FORGECHAT_USERNAME=owner
FORGECHAT_PASSWORD_HASH=replace_with_hash_from_forgechat.credentials
FORGECHAT_SESSION_SECRET=replace_with_random_output_from_forgechat.credentials
FORGECHAT_PUBLIC_ORIGIN=https://YOUR_EXISTING_DOMAIN
FORGECHAT_BASE_PATH=/forgechat
FORGECHAT_APP_DIR=/var/lib/forgechat/apps
FORGECHAT_ACCESS_DB=/var/lib/forgechat/apps/.access.sqlite3
FORGECHAT_REMEMBER_SESSION_SECONDS=2592000
FORGECHAT_PROVIDERS_FILE=/etc/forgechat/providers.json
FORGECHAT_OPENAI_API_KEY=set_only_on_the_vm
FORGECHAT_GEMINI_API_KEY=set_only_on_the_vm
FORGECHAT_AI_RATE_MAX_REQUESTS=30
FORGECHAT_AI_MAX_CONCURRENT_REQUESTS=2
# Optional Docker agent credentials are stored separately by server/deploy/linux-agent/setup.sh.
# FORGECHAT_AGENT_URL=http://127.0.0.1:8788
# FORGECHAT_AGENT_USERNAME=generated_by_the_privileged_setup
# FORGECHAT_AGENT_PASSWORD=generated_by_the_privileged_setup
# FORGECHAT_AGENT_TIMEOUT_SECONDS=150
